#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/mouse_keys.dtsi>

// Layer numbers. When several layers are active, ZMK uses the highest number first, so:
//   - Gaming sits low, so layers held from Gaming (Fun, Num...) work on top of it.
//   - Each layer has a "locked" copy below the held layers. "Lock X" switches to the copy,
//     so releasing the thumb key (which turns off the held layer) doesn't undo the lock,
//     and a layer held on top of a locked one still wins.
#define BASE     0
#define GAMING   1
#define NAV_L    2
#define MOUSE_L  3
#define MEDIA_L  4
#define NUM_L    5
#define SYM_L    6
#define FUN_L    7
#define NAV      8
#define MOUSE    9
#define MEDIA   10
#define NUM     11
#define SYM     12
#define FUN     13

/ {
    behaviors {
        mt: mod_tap {
            tapping-term-ms = <200>;
            flavor = "balanced"; // Great flavor for typing home-row mods smoothly
        };

        lt: layer_tap {
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        td_gaming: tap_dance_gaming {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>; // Time window to register the second tap (in milliseconds)
            bindings = <&trans>, <&to_gaming>;
        };

        // ---- Layer signals for the PC layer display (tools/layer_overlay.pyw) ----
        // Holding a layer also holds an unused F-key; lock keys tap F21 then that layer's key.
        // The display swallows these keys, so other apps never see them.
        //   held:  F13 Nav  F14 Media  F15 Num  F16 Sym  F17 Fun  F18 Mouse
        //   lock:  F21 + the layer's held key    to Base: F19    to Gaming: F20
#define SIG_MO(name, layer, key) \
        name: name { \
            compatible = "zmk,behavior-macro"; \
            #binding-cells = <0>; \
            wait-ms = <0>; \
            tap-ms = <0>; \
            bindings = <&macro_press &mo layer &kp key>, <&macro_pause_for_release>, <&macro_release &kp key &mo layer>; \
        };
#define SIG_LT(name, hold_macro) \
        name: name { \
            compatible = "zmk,behavior-hold-tap"; \
            #binding-cells = <2>; \
            tapping-term-ms = <200>; \
            flavor = "tap-preferred"; \
            bindings = <&hold_macro>, <&kp>; \
        };
#define SIG_TO(name, layer, key) \
        name: name { \
            compatible = "zmk,behavior-macro"; \
            #binding-cells = <0>; \
            wait-ms = <30>; \
            tap-ms = <30>; \
            bindings = <&macro_tap &to layer &kp key>; \
        };
#define SIG_LOCK(name, layer, key) \
        name: name { \
            compatible = "zmk,behavior-macro"; \
            #binding-cells = <0>; \
            wait-ms = <30>; \
            tap-ms = <30>; \
            bindings = <&macro_tap &to layer &kp F21 &kp key>; \
        };

        SIG_MO(sig_nav,   NAV,   F13)
        SIG_MO(sig_media, MEDIA, F14)
        SIG_MO(sig_num,   NUM,   F15)
        SIG_MO(sig_sym,   SYM,   F16)
        SIG_MO(sig_fun,   FUN,   F17)
        SIG_MO(sig_mouse, MOUSE, F18)

        // Thumb layer-taps: tap = key, hold = layer + signal. Use as &lt_nav 0 SPACE.
        SIG_LT(lt_nav,   sig_nav)
        SIG_LT(lt_media, sig_media)
        SIG_LT(lt_num,   sig_num)
        SIG_LT(lt_sym,   sig_sym)
        SIG_LT(lt_fun,   sig_fun)
        SIG_LT(lt_mouse, sig_mouse)

        // Locks go to the locked copies.
        SIG_TO(to_base,     BASE,    F19)
        SIG_TO(to_gaming,   GAMING,  F20)
        SIG_LOCK(to_nav,    NAV_L,   F13)
        SIG_LOCK(to_media,  MEDIA_L, F14)
        SIG_LOCK(to_num,    NUM_L,   F15)
        SIG_LOCK(to_sym,    SYM_L,   F16)
        SIG_LOCK(to_fun,    FUN_L,   F17)
        SIG_LOCK(to_mouse,  MOUSE_L, F18)
    };
};

// ---- Layer contents. Each one is used twice: held layer and locked copy. ----

#define NAV_KEYS \
&trans  &bootloader  &td_gaming  &trans     &trans     &trans    &trans      &trans    &trans     &trans     &trans     &trans \
&trans  &kp LGUI     &kp LALT    &kp LCTRL  &kp LSHFT  &trans    &caps_word  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans \
&trans  &trans       &kp RALT    &to_num    &to_nav    &trans    &kp INS     &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &trans \
                                 &trans     &trans     &trans    &kp RET     &kp BSPC  &kp DEL

#define MOUSE_KEYS \
&kp TAB    &bootloader  &trans    &trans     &trans      &trans    &trans     &trans          &trans          &trans        &trans           &kp BSPC \
&kp LCTRL  &kp LGUI     &kp LALT  &kp LCTRL  &kp LSHFT   &trans    &trans     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans \
&kp LSHFT  &trans       &kp RALT  &to_sym    &to_mouse   &trans    &trans     &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &kp ESC \
                                  &trans     &trans      &trans    &mkp RCLK  &mkp LCLK       &mkp MCLK

#define MEDIA_KEYS \
&trans  &bootloader  &trans    &trans     &trans     &trans    &trans        &trans        &trans        &trans        &trans        &trans \
&trans  &kp LGUI     &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &out OUT_USB  &kp C_PREV    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT    &trans \
&trans  &trans       &kp RALT  &to_fun    &to_media  &trans    &out OUT_BLE  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans \
                               &trans     &trans     &trans    &kp C_STOP    &kp C_PP      &kp C_MUTE

#define NUM_KEYS \
&trans  &kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBKT     &trans  &to_base   &trans     &td_gaming  &bootloader  &trans \
&trans  &kp SEMI   &kp N4  &kp N5   &kp N6  &kp EQUAL    &trans  &kp LSHFT  &kp LCTRL  &kp LALT    &kp LGUI     &trans \
&trans  &kp GRAVE  &kp N1  &kp N2   &kp N3  &kp BSLH     &trans  &to_num    &to_nav    &kp RALT    &trans       &trans \
                           &kp DOT  &kp N0  &kp MINUS    &trans  &trans     &trans

#define SYM_KEYS \
&trans  &kp LBRC   &kp AMPS  &kp ASTRK  &kp LPAR   &kp RBRC     &trans  &to_base   &trans     &td_gaming  &bootloader  &trans \
&trans  &kp COLON  &kp DLLR  &kp PRCNT  &kp CARET  &kp PLUS     &trans  &kp LSHFT  &kp LCTRL  &kp LALT    &kp LGUI     &trans \
&trans  &kp TILDE  &kp EXCL  &kp AT     &kp HASH   &kp PIPE     &trans  &to_sym    &to_mouse  &kp RALT    &trans       &trans \
                             &kp LPAR   &kp RPAR   &kp UNDER    &trans  &trans     &trans

#define FUN_KEYS \
&trans  &kp F12  &kp F7  &kp F8     &kp F9     &kp PSCRN          &trans  &to_base   &trans     &td_gaming  &bootloader  &trans \
&trans  &kp F11  &kp F4  &kp F5     &kp F6     &kp SLCK           &trans  &kp LSHFT  &kp LCTRL  &kp LALT    &kp LGUI     &trans \
&trans  &kp F10  &kp F1  &kp F2     &kp F3     &kp PAUSE_BREAK    &trans  &to_fun    &to_media  &kp RALT    &trans       &trans \
                         &kp K_APP  &kp SPACE  &kp TAB            &trans  &trans     &trans

/ {
    keymap {
        compatible = "zmk,keymap";

        // Node order must match the layer numbers above.

        base_layer {
            display-name = "Base";

            // -----------------------------------------------------------------------------------------
            // |  |  Q  |  W  |  F  |  P  |  B  |   |  J  |  L   |  U  |  Y  |  '  |  |
            // |  | A/G | R/A | S/C | T/S |  G  |   |  M  | N/S  | E/C | I/A | O/G |    |
            // |  |  Z  |  X  |  C  |  D  |  V  |   |  K  |  H   |  ,  |  .  |     | Studio |
            //                    | ESC | SPC | TAB |   | RET | BKSP | DEL |

            bindings = <
&trans  &kp Q        &kp W       &kp F          &kp P          &kp B            &kp J        &kp L         &kp U        &kp Y         &kp SQT         &trans
&trans  &mt LGUI A   &mt LALT R  &mt LCTRL S    &mt LSHFT T    &kp G            &kp M        &mt LSHFT N   &mt LCTRL E  &mt LALT I    &mt LGUI O      &trans
&trans  &kp Z  &kp X  &kp C          &kp D          &kp V            &kp K        &kp H         &kp COMMA    &mt RALT DOT  &trans &studio_unlock
                                 &lt_media 0 ESC  &lt_nav 0 SPACE  &lt_mouse 0 TAB  &lt_sym 0 RET  &lt_num 0 BSPC  &lt_fun 0 DEL
            >;
        };

        gaming_layer {
            display-name = "Gaming";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  1  |     |   | BASE|  U  |  I  |  O  |  P  | BKSP |
            // | SHFT |  A  |  S  |  D  |  2  |     |   | FUN | NUM | SYM |  L  |  M  |      |
            // | CTRL |  6  |  5  |  4  |  3  |     |   |     | NAV |MEDIA|  /  |  '  | ESC  |
            //                    | ESC | SPC | TAB |   | RET | BKSP| DEL |

            bindings = <
&kp TAB    &kp Q   &kp W   &kp E    &kp N1     &trans     &to_base   &kp U     &kp I      &kp O     &kp P    &kp BSPC
&kp LSHFT  &kp A   &kp S   &kp D    &kp N2     &trans     &sig_fun   &sig_num  &sig_sym   &kp L     &kp M    &trans
&kp LCTRL  &kp N6  &kp N5  &kp N4   &kp N3     &trans     &sig_mouse &sig_nav  &sig_media &kp FSLH  &kp SQT  &kp ESC
                           &kp ESC  &kp SPACE  &kp TAB    &kp RET    &kp BSPC  &kp DEL
            >;
        };

        nav_locked_layer   { display-name = "Nav (locked)";   bindings = <NAV_KEYS>; };
        mouse_locked_layer { display-name = "Mouse (locked)"; bindings = <MOUSE_KEYS>; };
        media_locked_layer { display-name = "Media (locked)"; bindings = <MEDIA_KEYS>; };
        num_locked_layer   { display-name = "Num (locked)";   bindings = <NUM_KEYS>; };
        sym_locked_layer   { display-name = "Sym (locked)";   bindings = <SYM_KEYS>; };
        fun_locked_layer   { display-name = "Fun (locked)";   bindings = <FUN_KEYS>; };

        nav_layer   { display-name = "Nav";   bindings = <NAV_KEYS>; };
        mouse_layer { display-name = "Mouse"; bindings = <MOUSE_KEYS>; };
        media_layer { display-name = "Media"; bindings = <MEDIA_KEYS>; };
        num_layer   { display-name = "Num";   bindings = <NUM_KEYS>; };
        sym_layer   { display-name = "Sym";   bindings = <SYM_KEYS>; };
        fun_layer   { display-name = "Fun";   bindings = <FUN_KEYS>; };
    };
};
